rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{id} {
      allow read: if signedIn();
      allow create, update: if request.auth.uid == id
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.bio.size() <= 600
        && request.resource.data.skills is list && request.resource.data.skills.size() <= 30;
      allow delete: if false;
    }
    match /jobs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
        && request.resource.data.company.size() <= 80 && request.resource.data.location.size() <= 60
        && request.resource.data.description.size() >= 20 && request.resource.data.description.size() <= 2000
        && request.resource.data.type in ['Full-time','Part-time','Contract','Gig','Apprenticeship','Internship'];
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /applications/{id} {
      allow read: if signedIn() && (resource.data.applicantId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.applicantId == request.auth.uid
        && id == request.resource.data.jobId + '_' + request.auth.uid
        && request.resource.data.ownerId == get(/databases/$(db)/documents/jobs/$(request.resource.data.jobId)).data.ownerId
        && request.resource.data.note.size() <= 500;
      allow update, delete: if false;
    }
  }
}
